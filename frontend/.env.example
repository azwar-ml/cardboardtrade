# Copy to .env.local. Use a unique password before first production initialization.
CONSOLE_ADMIN_PASSWORD=replace-with-a-strong-random-password
CONSOLE_SALES_PASSWORD=replace-with-a-strong-random-password

# Optional isolated data directory for QA and staging. Defaults to frontend/data.
# TRADE_DATA_DIR=./data
# Server-side FastAPI endpoint. Both services must use the same TRADE_DATA_DIR.
AGENTS_API_URL=http://127.0.0.1:8000
