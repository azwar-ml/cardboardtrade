# Use the SAME absolute TRADE_DATA_DIR in both services. Keep a single FastAPI worker.
TRADE_DATA_DIR=D:/cardboard-package/Cardboard/cardboard-trade/frontend/data
# Seeds and allowed domains are operator-approved public sources; review relevant terms first.
# No seeds are enabled by default. Comma-separated HTTPS URLs, at most 20 per research job.
DISCOVERY_SEED_URLS=
DISCOVERY_ALLOWED_DOMAINS=
DISCOVERY_SEARCH_PROVIDER=duckduckgo
# Set your real key locally. Public policy needs no pre-listed supplier URLs;
# allowlist policy requires permitted result domains below.
SERPAPI_API_KEY=
# public permits guarded research of new public search-result domains.
# allowlist restricts crawling to DISCOVERY_ALLOWED_DOMAINS and configured seed hosts.
# Neither option overrides robots, private-network protection or access restrictions.
DISCOVERY_SOURCE_POLICY=public
# First organic result page only; no pagination. Bounded crawling (1-20 pages).
DISCOVERY_MAX_PAGES=12
# Keep environment startup disabled; saved Admin automation resumes at 48 hours.
# Due work and cancellations are checked by the running backend, not the browser.
DISCOVERY_SCHEDULE_SECONDS=0
DISCOVERY_SCHEDULE_PRODUCT=corrugated packaging
DISCOVERY_SCHEDULE_CITY=Lahore
DISCOVERY_SCHEDULE_KEYWORDS=manufacturer
# Admin changes persist in SQLite and take precedence over these schedule defaults.
# New keys added to backend/.env are detected automatically; other env changes require restart.
DISCOVERY_ADMIN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared budget resets only on provider-confirmed billing-cycle renewal.
DISCOVERY_MONTHLY_SEARCH_LIMIT=20
DISCOVERY_RESERVED_SEARCHES=50
# Reuse successful queries and block repeated failed attempts for six hours.
DISCOVERY_SEARCH_CACHE_SECONDS=21600

# Fixed workload assignments. Keys 4-15 are unused.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
QUALIFICATION_ADDITIONAL_AI_ENABLED=false
# Optional exact identifier, validated against API discovery and published free-tier eligibility.
GEMINI_MODEL=
GEMINI_API_VERSION=v1beta
# Set a UTC ISO timestamp only after resolving a provider quota/billing pause.
GEMINI_QUOTA_REVIEWED_AT=
# Conservative per-job cap at published paid-tier prices, independent of free-tier eligibility.
QUALIFICATION_MAX_JOB_USD=0.02
